{
  "name": "devsecops-masterclass",
  "version": "1.0.0",
  "private": true,
  "description": "DevSecOps Masterclass: static site delivered by a 20-stage GitHub Actions pipeline to Docker on AWS EC2.",
  "license": "MIT",
  "scripts": {
    "validate:html": "htmlhint \"src/**/*.html\"",
    "validate:css": "stylelint \"src/**/*.css\"",
    "validate:js": "node --check src/js/app.js",
    "lint": "eslint src tests scripts",
    "test": "jest",
    "coverage:report": "jest --coverage && node scripts/coverage_summary.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/js/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
