# Managed by Ansible — DevSecOps Masterclass Stage 17.
# Host nginx terminates public traffic on :80 and proxies to the
# site container listening on 127.0.0.1:{{ container_port }}.

upstream devsecops_site {
    server 127.0.0.1:{{ container_port }};
    keepalive 16;
}

server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name _;

    server_tokens off;
    client_max_body_size 1m;

    access_log /var/log/nginx/devsecops.access.log;
    error_log  /var/log/nginx/devsecops.error.log warn;

    location / {
        proxy_pass         http://devsecops_site;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    location = /healthz {
        access_log off;
        proxy_pass         http://devsecops_site/healthz;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   Connection "";
    }
}
